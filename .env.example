# Copia este archivo como `.env` para desarrollo local (no se sube al repo).
# En Vercel estas variables se configuran en:
#   Project → Settings → Environment Variables

# Puerto del servidor local (en Vercel lo pone la plataforma)
PORT=3000

# MongoDB local (desarrollo)
# MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB Atlas (obligatorio en Vercel)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
MONGODB_BD=ag_clothing
